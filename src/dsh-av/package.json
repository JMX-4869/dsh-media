{
  "name": "dsh-av",
  "version": "0.5.0",
  "description": "DeepSeek Harness 音视频插件（一体）：声音那一层是纯 JS 的音色转换（hubert + rmvpe + net_g 三个 ONNX 网络在 Node 里跑，不依赖 Python / torch），视频那一层把音频渲染成片；并且内置音乐台 —— 设置页里的网页作曲台，写完导出 WAV 直接喂给 convert 换音色、render 成片。",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "voices.js",
    "convert.js",
    "wav.js",
    "png.js",
    "render.js",
    "mel.mjs",
    "hubert.mjs",
    "netg.mjs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "icon.svg",
    "www/音乐台.html"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "voice",
    "onnx",
    "rvc",
    "video",
    "music",
    "daw"
  ],
  "license": "MIT"
}
